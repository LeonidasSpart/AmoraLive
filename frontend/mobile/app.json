{
  "expo": {
    "name": "Amora",
    "slug": "amora",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "amora",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "one.amoramatch.app",
      "adaptiveIcon": {
        "backgroundColor": "#090713"
      }
    },
    "ios": {
      "bundleIdentifier": "one.amoramatch.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "https://api.amoramatch.one"
    }
  }
}
