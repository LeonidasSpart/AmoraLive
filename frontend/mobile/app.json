{
  "expo": {
    "name": "Amora",
    "slug": "amora",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "amora",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "one.amoramatch.app",
      "permissions": ["CAMERA", "RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS"],
      "adaptiveIcon": {
        "backgroundColor": "#090713"
      }
    },
    "ios": {
      "bundleIdentifier": "one.amoramatch.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Amora uses your camera for live video matches and live rooms.",
        "NSMicrophoneUsageDescription": "Amora uses your microphone for live video matches and live rooms."
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@livekit/react-native-webrtc"
    ],
    "extra": {
      "apiUrl": "https://api.amoramatch.one"
    }
  }
}
