{
  "expo": {
    "name": "Amora",
    "slug": "amora",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "amora",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "one.amoramatch.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#090713"
      },
      "versionCode": 20,
      "backgroundColor": "#070511"
    },
    "ios": {
      "bundleIdentifier": "one.amoramatch.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Amora uses your camera for live video matches, live rooms, and profile photos.",
        "NSMicrophoneUsageDescription": "Amora uses your microphone for live video matches and live rooms.",
        "NSPhotoLibraryUsageDescription": "Amora needs access to your photos so you can set a profile picture."
      },
      "buildNumber": "20",
      "backgroundColor": "#070511"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@livekit/react-native-webrtc",
      "react-native-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "Amora needs access to your photos so you can set a profile picture."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://api.amoramatch.one"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#070511"
    },
    "backgroundColor": "#070511",
    "primaryColor": "#ff4fa3"
  }
}
