# Amora Frontend Environment Variables

# API
NEXT_PUBLIC_API_URL=https://api.amora.app
NEXT_PUBLIC_WS_URL=wss://api.amora.app

# Auth
NEXT_PUBLIC_AUTH_DOMAIN=auth.amora.app

# App
NEXT_PUBLIC_APP_NAME=Amora
NEXT_PUBLIC_APP_URL=https://amora.app

# Features
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_PWA=true

# Third Party
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Payments
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_CRYPTO_ENABLED=true

# Maps (for location features)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Upload
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=